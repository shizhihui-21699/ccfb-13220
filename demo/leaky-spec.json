{
  "rules": [
    {
      "kind": "path",
      "value": "exports/*.csv",
      "note": "customer data export (PII)"
    },
    {
      "kind": "path",
      "value": "keys/",
      "note": "private signing keys must never be in a repository"
    },
    {
      "kind": "preset",
      "value": "aws_access_key",
      "note": "production AWS access key"
    },
    {
      "kind": "preset",
      "value": "aws_secret_key"
    },
    {
      "kind": "preset",
      "value": "private_key"
    }
  ],
  "purge_whole_file": true,
  "scan_commit_messages": false,
  "max_scan_bytes": 8388608
}
